; A set of useful I2S and TDM routines for DickinsAudio projects
;
;



.program i2s_in
; I2S channel audio slaved from clock
; Input pin: DI 
; JMP pin:   LRCK
; 50% LR CLK duty cycle
; And falling edge LR is the start of frame


public entry_point:
    jmp pin high                        ; Wait for LRCLK to become high
    jmp entry_point
high:
    jmp pin high                        ; Wait for it to become low
    set x,1
    set y,30     
    jmp bit
word:
    nop                  [12]           ; Wait out the rest of the last cycle
.wrap_target
    in pins, 1           [7]           ; Get last bit of the word
    push noblock         [7]
bit:
    in pins, 1           [7]            ; Get a bit
    jmp y-- bit          [7]            ;  
    in pins, 1
    set y, 29                           ;
    jmp x-- word                        ; 
stall:
; TODO  We really should also ensure that LRCLK is high here.  It should always be the case,
; TODO  unless the I2S stutters.  In which case we can get skewed data.
    jmp pin stall                       ; Wait for LRCLK to fall
    set x, 1             [7]            ; Skip the first half clock cycle
.wrap                                   ; Return to the start


.program i2s_master_out
; Super simple I2S audio output master - may change to PLL clock later
;
; Output pin order: BCLK WCLK DO
; Using side pins, though makes this need a lot of words

.side_set 2

public entry_point:
.wrap_target
Frame0:             
    out pins, 1       [3]   side 0b00       ; Start of frame
    set x, 30         [3]   side 0b00       ; 
    pull noblock      [7]   side 0b01       ; 
Data0:
    out pins, 1       [7]   side 0b00       ; 31 bit loop
    jmp x-- Data0     [7]   side 0b01       ;
Frame1:
    out pins, 1       [3]   side 0b10       ; Second half of 
    set x, 30         [3]   side 0b10       ; 
    pull noblock      [7]   side 0b11       ; 
Data1:
    out pins, 1       [7]   side 0b10       ; 31 bit loop
    jmp x-- Data1     [7]   side 0b11       ;
.wrap


.program i2s_slave_out
;
; Input pin is   LRCLK
; Output pin is  D0

public entry_point:
    jmp pin start                       ; Wait for LRCLK to become high
    jmp entry_point
.wrap_target
start:
    jmp pin start                       ; Wait for LRCLK to become low
    out pins, 1                         ; Last bit of previous word
    pull noblock
    set y, 30            [12]           ; 
bit0:
    out pins, 1          [7]            ; Push out bits
    jmp y-- bit0         [7]            ;  
    out pins, 1                         ; Push last bit         
    pull noblock
    set y, 30           [13]
bit1:
    out pins, 1          [7]            ; Push out bits
    jmp y-- bit1         [7]            ;  
.wrap


.program i2s_follower_out
;
; Jmp pin is     LRCLK
; Output pin is  D0
; Side set is LRCLK BCLK out

.side_set 2

public entry_point:
    jmp pin start               side 0b10   ; Wait for LRCLK to become high
    jmp entry_point             side 0b00   ;
.wrap_target
start:
    jmp pin start               side 0b10   ; Wait for LRCLK to become low
    out pins, 1          [2]    side 0b00   ; Last bit of previous word
    pull noblock         [3]    side 0b00   ; 
    set y, 30            [7]    side 0b01   ; 
bit0:
    out pins, 1          [7]    side 0b00   ; Push out bits
    jmp y-- bit0         [7]    side 0b01   ;  
    out pins, 1          [3]    side 0b10   ; Push last bit         
    pull noblock         [3]    side 0b10
    set y, 30            [7]    side 0b11    
bit1:
    out pins, 1          [7]    side 0b10   ; Push out bits
    jmp y-- bit1         [7]    side 0b11   ;  
.wrap



.program i2s_mck
; Transmit an I2S system / master clock.
;
public entry_point:
.wrap_target
    set pins 1 [1]
    set pins 0 [1]
.wrap




% c-sdk {


static inline void i2s_in_init(PIO pio, uint8_t sm, int offset, int lrclk, int din, int divN, int divF) 
{
    pio_gpio_init(pio, lrclk);
    pio_gpio_init(pio, din);

    pio_sm_config sm_config = i2s_in_program_get_default_config(offset);
    sm_config_set_in_pins  (&sm_config, din);
    sm_config_set_jmp_pin  (&sm_config, lrclk);
    sm_config_set_in_shift (&sm_config, false, false, 0);
    pio_sm_init(pio, sm, offset + i2s_in_offset_entry_point, &sm_config);
    uint32_t pin_mask = (1 << din) | (1 << lrclk);                                       // Everything synced off LR clock normal rate
    pio_sm_set_pindirs_with_mask(pio, sm, 0, pin_mask);
    pio_sm_set_clkdiv_int_frac          (pio, sm, divN, divF);
}

static inline void i2s_master_out_init(PIO pio, int sm, int offset, int bclk, int dout, int divN, int divF) 
{
    pio_gpio_init(pio, bclk);         // I2S normal clock
    pio_gpio_init(pio, bclk+1);       // 
    pio_gpio_init(pio, dout);         // Data out
    
    pio_sm_config sm_config = i2s_master_out_program_get_default_config(offset);
    sm_config_set_out_pins     (&sm_config, dout, 1);
    sm_config_set_sideset_pins (&sm_config, bclk);
    sm_config_set_out_shift    (&sm_config, false, false, 32);
    pio_sm_init(pio, sm, offset + i2s_master_out_offset_entry_point, &sm_config);

    uint32_t pin_mask = (1 << dout) | (3 << bclk);               // Data out and two clocks
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask); 
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    
    pio_sm_set_clkdiv_int_frac          (pio, sm, divN, divF);
}

static inline void i2s_slave_out_init(PIO pio, uint8_t sm, int offset, int lrclk, int dout, int divN, int divF) 
{
    pio_gpio_init(pio, lrclk);
    pio_gpio_init(pio, dout);

    pio_sm_config sm_config = i2s_slave_out_program_get_default_config(offset);
    sm_config_set_jmp_pin  (&sm_config, lrclk);
    sm_config_set_out_pins (&sm_config, dout, 1);
    sm_config_set_out_shift(&sm_config, false, false, 32);
    pio_sm_init(pio, sm, offset + i2s_slave_out_offset_entry_point, &sm_config);
    uint32_t pin_mask = (1 << lrclk);   
    pio_sm_set_pindirs_with_mask(pio, sm, 0, pin_mask);
    pin_mask = 1 << dout;   
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask);
    pio_sm_set_clkdiv_int_frac          (pio, sm, divN, divF);
}

static inline void i2s_follower_out_init(PIO pio, uint8_t sm, int offset, int lrclk_in, int dout, int bclk_out, int divN, int divF) 
{
    pio_gpio_init(pio, lrclk_in);
    pio_gpio_init(pio, dout);
    pio_gpio_init(pio, bclk_out);
    pio_gpio_init(pio, bclk_out+1);

    pio_sm_config sm_config = i2s_follower_out_program_get_default_config(offset);
    sm_config_set_jmp_pin  (&sm_config, lrclk_in);
    sm_config_set_out_pins (&sm_config, dout, 1);
    sm_config_set_sideset_pins (&sm_config, bclk_out);
    sm_config_set_out_shift(&sm_config, false, false, 32);
    pio_sm_init(pio, sm, offset + i2s_follower_out_offset_entry_point, &sm_config);
    uint32_t pin_mask = (1 << lrclk_in);   
    pio_sm_set_pindirs_with_mask(pio, sm, 0, pin_mask);
    pin_mask = (1 << dout) | (3 << bclk_out);   
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask);
    pio_sm_set_clkdiv_int_frac          (pio, sm, divN, divF);
}

static void i2s_mck_init(PIO pio, uint8_t sm, uint8_t offset, uint8_t mck_pin, int divN, int divF) {
    pio_gpio_init               (pio, mck_pin);
    pio_sm_config sm_config = i2s_mck_program_get_default_config(offset);
    sm_config_set_set_pins(&sm_config, mck_pin, 1);
    pio_sm_init                 (pio, sm, offset, &sm_config);
    uint pin_mask = (1u << mck_pin);
    pio_sm_set_pins_with_mask   (pio, sm, 0, pin_mask);  // zero output
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_clkdiv_int_frac  (pio, sm, divN, divF);
}

%}